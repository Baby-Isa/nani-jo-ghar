{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "(timeout 55 pip install -q scipy playwright >/dev/null 2>&1 || true); exit 0",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node build/tools/ops/unpushed.mjs 2>/dev/null; exit 0",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
