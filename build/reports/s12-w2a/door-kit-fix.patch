+      if (m) {
+        dx = m[2] === "%" ? (+m[1] / 100) * r.width : +m[1] || 0;
+        dy = m[3] == null ? 0 : m[4] === "%" ? (+m[3] / 100) * r.height : +m[3] || 0;
