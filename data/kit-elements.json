{
  "_about": "S13-T (the one loop): every shared element of the kit, where it shows and where its code lives. build/tools/review/kitsheet.mjs crops each element from every LIVE page (the parked games are out) at 1366x768 and 915x412 into one side-by-side sheet (the judge passes the element on that sheet: the same look in every game; the help ladder is the stuck player's screen at each rung, not an element); build/tools/review/kitmap.mjs prints, per element, every file:line its grep rules find (the kit's home first, then the copies a builder must delete), and build/tools/ops/brief.mjs pastes it under PLACES for a brief naming the element (spec field elements). A place is {at, sel?, delay?, flow?, profile?, every?} (every: one frame at each time the moment comes, e.g. each rung of the stuck player) (at: an evidence moment, build/sandbox/lib/moments.mjs; sel: a CSS selector, canvas:<name> or hook:cook.<fn>/hook:heal.<fn>) or {none: why} (the element is not on that page by design). A place no driver reaches is listed as such on the sheet, never dropped. rowWords: the fix-list rows about the element (regress by element, for a brief's REGRESSION ROWS).",
  "pages": {
    "index": { "flow": "house", "title": "the house (index.html)" },
    "first": { "flow": "first", "title": "first launch (first.html and its first Cook rounds)" },
    "day": { "flow": "day:door#stuck", "title": "a day at Nani's: the door (day.html)" },
    "cook": { "flow": "cook:chai-tray#stuck", "title": "Cook: chai (cook.html)" },
    "clinic": { "flow": "clinic:heal-eye#stuck", "title": "the clinic: the eye test (clinic.html)" },
    "lab": { "flow": "lab:cook/chai-tray", "title": "Cook on the game host (lab.html)" }
  },
  "elements": {
    "face circle": {
      "sel": ".njg-rq-card .oc-face, #intro .ic-face, .ng-face, .cl-card-face, .njg-face",
      "moves": false,
      "grep": ["\\boc-face\\b", "\\bng-face\\b", "\\bcl-card-face\\b", "\\bcl-face\\b", "\\bcv-face\\b", "\\bpm-face\\b", "\\bic-face\\b", "\\bnc-face\\b", "\\bm-face\\b", "\\blface\\b", "--njg-(big-|guide-)?face\\b", "--oc-face\\b", "--sb-face\\b"],
      "rowWords": "face circle|face in the|the face|faces? (size|ring)|ART-08",
      "places": {
        "index": { "none": "the house shows no face circle" },
        "first": { "at": "life:popup-open", "delay": 300 },
        "day": { "at": "rec:first-line", "sel": ".ng-face, .day-face, .njg-face" },
        "cook": { "at": "life:popup-open", "delay": 300 },
        "clinic": { "at": "life:popup-open", "delay": 300 },
        "lab": { "at": "life:popup-open", "delay": 300 }
      }
    },
    "word card": {
      "sel": ".wc-card",
      "moves": false,
      "grep": ["\\bwc-[a-z-]+", "WordCard\\."],
      "rowWords": "word card|word-card|\\bwc-",
      "places": {
        "index": { "none": "the house shows no word card" },
        "first": { "at": "visible:.njg-rq-card .wc-card", "sel": ".njg-rq-card .wc-card" },
        "day": { "at": "visible:.wc-card" },
        "cook": { "at": "visible:.njg-rq-card .wc-card", "sel": ".njg-rq-card .wc-card", "flow": "cook:chai-tray#speed1", "profile": "seen" },
        "clinic": { "at": "visible:.wc-card" },
        "lab": { "at": "visible:.njg-rq-card .wc-card", "sel": ".njg-rq-card .wc-card", "flow": "lab:cook/chai-tray#speed1" }
      }
    },
    "order card": {
      "sel": "#mission .oc-card, .cl-side .oc-card, .njg-side .oc-card",
      "moves": false,
      "grep": ["\\boc-(card|row|head|headline|face|items|item|parts|part|done-tk|fold|closed-big|big)\\b", "OrderCard\\.", "\\bcl-card\\b", "\\.ladder\\b|\\.lsec\\b|\\.r6\\b"],
      "rowWords": "order card|the card's|sidebar card|card rows?|recipe card|\\bladder\\b",
      "places": {
        "index": { "none": "no order on the house page" },
