  "grammar": {
    "_about": "Positions follow the noun (Roadmap syllabus). Slots: n (a number word), attr (a colour), x (the item), anchor (an object, a person or a placed item), rel (the relation word), all/nothing/leave (words below). Code only fills slots; another language swaps this block.",
    "rows": {
      "place": "{attr} {x} {anchor} {rel}",
      "unary": "{attr} {x} {rel}",
      "count": "{n} {x} {anchor} {rel}",
      "countUnary": "{n} {x} {rel}",
      "leave": "{leave} {attr} {x}",
      "class": "{all} {class} {anchor} {rel}",
      "not": "{nothing} {anchor} {rel}",
      "notUnary": "{nothing} {rel}"
    },
    "words": {"all": "ph-all", "nothing": "ph-nothing", "leave": "ph-leave"}
  },

