    "on": {"word": "ph-rel-on"},
    "next-to": {"word": "ph-rel-nextto", "derived": "adjacent"},
    "in-front": {"word": "ph-rel-front"},
    "middle": {"word": "ph-rel-middle", "unary": true},
    "back": {"word": "ph-rel-back", "unary": true},
