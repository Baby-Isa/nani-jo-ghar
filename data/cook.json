 "recipes": {
  "chai": {
   "name": "cook-chai",
   "english": "Chai",
   "price": 4,
   "stations": [
    "pour",
    "add",
    "boil",
    "count",
    "pour"
   ],
   "_about": "The Chai tray (js/cook/stations/chai-tray.js): a cup for each person on the tray, each with their face. The customer orders chai at the counter; at the tray each person says how they like theirs (milk or no milk, how many sugars or none; at level 3 an extra and half or full), so those rows wait for the tray (`when`). Level 1: the customer's own cup; level 2: two people; level 3: three, plus extras and half/full. Tastes are only a bias (tasteChance).",
   "lists": {
    "family": [
     "nana",
     "ma",
     "cousin"
    ]
   },
   "slots": {
    "cups": {
     "type": "people",
     "who": "$family",
     "count": {
      "byLevel": [
       1,
       2,
       3
      ]
     },
     "tastes": "chai",
     "each": {
      "dudh": {
       "chance": 0.65,
       "taste": "dudh",
       "tasteChance": 0.5
      },
      "khun": {
       "int": [
        1,
        3
       ],
       "zero": 0.2,
       "taste": "khun",
       "tasteChance": 0.5
      },
      "extra": {
       "byLevel": [
        null,
        null,
        {
         "pick": [
          null,
          "spi-10",
          "veg-14"
         ],
         "taste": "extra",
         "tasteChance": 0.4
        }
       ]
      },
      "amount": {
       "byLevel": [
        null,
        null,
        {
         "pick": [
          "ph-half",
          "ph-full"
         ]
        }
       ]
      }
     }
    }
   },
   "say": [
    {
     "frame": "order",
     "x": [
      "cook-chai"
     ]
    },
    {
     "forEach": "$cups",
     "for": "$it.who",
     "say": [
      {
       "if": "it.dudh",
       "frame": "and",
       "x": [
        "cook-dudh"
       ],
       "when": "chai-tray"
      },
      {
       "if": "!it.dudh",
       "frame": "no",
       "x": [
        "cook-dudh"
       ],
       "when": "chai-tray"
      },
      {
       "if": "it.khun",
       "frame": "and",
       "x": [
        {
         "n": "$it.khun",
         "of": "cook-khun"
        }
       ],
       "when": "chai-tray"
      },
      {
       "if": "!it.khun",
       "frame": "no",
       "x": [
        "cook-khun"
       ],
       "when": "chai-tray"
      },
      {
       "if": "it.extra",
       "frame": "and",
       "x": [
        "$it.extra"
       ],
       "when": "chai-tray"
      },
      {
       "if": "it.amount",
       "frame": "and",
       "x": [
        "$it.amount"
       ],
       "when": "chai-tray"
      }
     ]
    }
   ],
   "need": [],
   "steps": [
    "Water",
    "Tea",
    "Boil",
    "Cups",
    "Pour"
   ],
   "run": [
    {
     "do": "interrupt"
    },
    {
     "do": "chai-tray",
     "cups": "$cups",
     "as": "tray"
    },
    {
     "do": "result",
     "key": "chai",
     "slots": [
      "cups"
     ]
    },
    {
     "do": "serve",
     "key": "glass-chai",
     "count": "$tray.served"
    },
    {
     "do": "wait",
     "ms": 600
    }
   ]
  },
  "maani": {
   "name": "cook-maani",
