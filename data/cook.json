 "grammar": {
  "_about": "How this language builds sentences. The code only names roles (an order's first line, a list, a counted noun); the words are in `words` and the frames in `lines`. Another language (Gujarati first) swaps this block with those two. Order ladder: `order` frames start each dish, `list.next` joins things in any order, `then` (the line key) joins the next step of a sequence (\"Ne poi {x}.\", a draft from Zafar, Mum to confirm), `no` says leave-it-out rows, and `then_word` is the linker's word id: from its word stage 3 the ladder stops drawing the sequence and only the spoken linker tells you the order.",
  "numbers": {
   "1": "num-01",
   "2": "num-02",
   "3": "num-03",
   "4": "num-04",
   "5": "num-05"
  },
  "count": "{n} {x}",
  "sep": " ",
  "order": {
   "first": "need",
   "next": "and"
  },
  "list": {
   "first": "{x}.",
   "next": "and"
  },
  "number": "{x}!",
  "then": "then",
  "no": "no",
  "then_word": "lnk-nepoi"
 },
 "verdicts": {
  "_about": "Words shown over the action after a timing or a pour (English UI). Mechanics name them by key.",
